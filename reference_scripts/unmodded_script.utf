    if %BtnRes = -10 jumpf                 ;ＥＳＣで抜ける

;  goto *rmenu_custom_btlp

~
;mov %tmordflg,0

   if %remnu_data = on csp rmenu_databtn
csp rmenu_back
csp rmenu_btn1
csp rmenu_btn2
csp rmenu_btn3
csp rmenu_btn_Exit

print 4,500

