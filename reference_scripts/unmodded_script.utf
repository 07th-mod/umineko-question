*r_grim_hyouji_ep3_2

	csp r_tips_txt_lsp
	csp tips_next_lsp
	csp tips_back_lsp
	csp cha_next_lsp
	csp cha_back_lsp

	notif %r_hyouji_grim = 0 jumpf
