ld l,$GOH_OmakaseA1,80

langjp「では紗音さん、申し訳ありませんがお屋敷内の見回りをお願いします。@私はここで、親族の皆さんのご用命の待機をしておりますので。」@
langen^"In that case, forgive me, Shannon-san, but I'll ask that you patrol the mansion.^@^  I will stay here, awaiting the family's orders."^@
ld r,$SHA_fumanA1,80

langjp「は、……はい…。」\
