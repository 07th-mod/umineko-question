if ?r[%r_hyouji_cha_ma][condition] = 1 mov $r_cha_tati_path,"bmp\r_click\cha_tati\ep4_2\lam"

;(状態に応じたテキスト文を表示）
if ?r[%r_hyouji_cha_ma][condition] = 0 mov $r_txt_path,"bmp\r_click\text\txt_def2.png"
if ?r[%r_hyouji_cha_ma][condition] = 1 mov $r_txt_path,"bmp\r_click\text\cha\ep4_2\lam_1.png"
return
