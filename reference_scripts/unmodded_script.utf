return

*mbg_special
	getparam $meta_tmp2,%meta_tmp3,%witchh10  ;ファイルパス、表示方法

	notif %witchh10 = 1 jumpf
		mov %text_mbg,1
		mov $text_mbg,$meta_tmp2

		mov $witchh4, $meta_tmp2
		setLangString $witchh4, "c"
		mov $meta_tmp2, $witchh4
	~

	;文字にblack、whiteを指定したら、黒、白入れて対応する。
	if $meta_tmp2 = "black" lsp msp_bg,":c;bmp\r_click\black.bmp",0,0 jumpf
	if $meta_tmp2 = "white" lsp msp_bg,":c;bmp\r_click\white.bmp",0,0 jumpf


	lsp msp_bg,$meta_tmp2,0,0

	~
	print %meta_tmp3
return
