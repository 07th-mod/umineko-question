		if %grim_page = 1 mov $r_grim_txt_path,":a;bmp\r_click\text\notes\ep1n4_1.png"
	*grim_5

	notif %r_hyouji_grim = 6 goto *grim_6
		cell grim6_lsp,1
		if %grim_page = 1 mov $r_grim_txt_path,":a;bmp\r_click\text\notes\ep1n5_1.png"
	*grim_6

