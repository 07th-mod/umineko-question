*e_
*erase
*silent

 getparam %Free3,%Free1      ;属性とチャンネルを取得

 if %Free3 = 1 E_B

 notif %Free3 = 2 jumpf

;    if %Free1 > 6 mov %Free1,1
;    if %Free1 < 0 mov %Free1,1

    mov %Free2,%Free1
    add %Free2,Me_s_Ch0

    add %Free1,10
    dwavestop %Free1

  mov %%Free2,0                  ;使用チャンネルフラグを消す


   return

 ~
 notif %Free3 = 3 jumpf

    if %Free1 > 3 mov %Free1,1
    dwavestop %Free1

   return

 ~
 notif %Free3 = 0 jumpf 


 stop
