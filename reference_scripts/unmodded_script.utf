	setRLangString $witchh4, ""
	lsp r_txt_lsp,$witchh4,188,r_top_y
		print 1
		return
	~

	mov %r_hyouji,1

	;フラグがないtipsを選択されていたら、tipsに０を入れてスキップさせる。
	if ?tips[%r_hyouji_tips][tips_flg] = 0 mov %r_hyouji_tips,0 : mov %tips_page,1 : return

	;mov %r_hyouji_cha,0 ;tispの表示を０（なしにする）
