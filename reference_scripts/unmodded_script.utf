	if %BtnRes = cha_back_lsp dec %cha_text_page :  mov %cha_page_flg,%r_hyouji_cha_ma : gosub *r_cha_hyouji_ep4_2 : seplay 9,1001 : print 1 : jumpf

	;キャラアイコンが押された場合、それぞれのキャラへとジャンプする
