		exbtn t_btn_ep4_ura_tea_lsp,t_btn_ep4_ura_tea_lsp,""
		btnwait2 %BtnRes

		if %BtnRes = t_btn_ep1_ura_tea_lsp btndef "" : mov %scenario_Number,1 : csp -1 : seplay 9,17 : bg white,10 : delay 2000 : goto *ura_teatime_1
		if %BtnRes = t_btn_ep2_ura_tea_lsp btndef "" : mov %scenario_Number,2 : csp -1 : seplay 9,17 : bg white,10 : delay 2000 : goto *ura_teatime_2
