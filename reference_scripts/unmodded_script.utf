	lsp r_tips1_back_lsp,r_tips1_back,12,r_top_y,150

	;tipsの表示（tipsナンバーによって表示するtipsの数を変化
	mov %tmp,12 : 	mov %tmp1,r_top_y
	notif ?tips[1][tips_flg] = 1 jumpf
		mov $witchh4, r_tips_2_1
		setRLangString $witchh4, "/2,0,3"
		lsp tips1_lsp,$witchh4,%tmp,%tmp1
		add %tmp1,32
	~
	notif ?tips[2][tips_flg] = 1 jumpf
		mov $witchh4, r_tips_2_2
		setRLangString $witchh4, "/2,0,3"
		lsp tips2_lsp,$witchh4,%tmp,%tmp1
		add %tmp1,32
	~
	notif ?tips[3][tips_flg] = 1 jumpf
		mov $witchh4, r_tips_2_3
		setRLangString $witchh4, "/2,0,3"
		lsp tips3_lsp,$witchh4,%tmp,%tmp1
		add %tmp1,32
	~
	notif ?tips[4][tips_flg] = 1 jumpf
		mov $witchh4, r_tips_2_4
		setRLangString $witchh4, "/2,0,3"
		lsp tips4_lsp,$witchh4,%tmp,%tmp1
		add %tmp1,32
	~
	notif ?tips[5][tips_flg] = 1 jumpf
		mov $witchh4, r_tips_2_5
		setRLangString $witchh4, "/2,0,3"
		lsp tips5_lsp,$witchh4,%tmp,%tmp1
		add %tmp1,32
	~
