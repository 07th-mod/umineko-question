	if %BtnRes = ma4_s_btn_lsp mov %r_hyouji_cha_ma,ma4_s : gosub *character_icon_selected_ep4_2
	if %BtnRes = ma4_rg_btn_lsp mov %r_hyouji_cha_ma,ma4_rg : gosub *character_icon_selected_ep4_2
	if %BtnRes = ma4_goa_btn_lsp mov %r_hyouji_cha_ma,ma4_goa : gosub *character_icon_selected_ep4_2

~

