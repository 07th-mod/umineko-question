	if %cha_text_page > ?r_cha_text[2][%r_hyouji_cha][1] mov %cha_text_page,1
	notif %cha_page_flg = %r_hyouji_cha mov %cha_text_page,1

	;キャラアイコンが押された場合、それぞれのキャラへとジャンプする
	if %r_hyouji_cha = ma_kin : gosub *r_cha_kin_ep2_2        ;金蔵
	if %r_hyouji_cha = ma_but : gosub *r_cha_but_ep2_2        ;戦人
