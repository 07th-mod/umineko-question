	for %tmp2 = kin_btn_lsp to ber_btn_lsp : csp %tmp2 :next
	for %tmp2 = tips1_lsp to tips1_lsp : csp %tmp2 :next
	csp r_tips_txt_lsp
	csp tips_next_lsp
	csp tips_back_lsp
	csp r_cha_back_lsp
