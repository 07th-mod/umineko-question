	if %r_hyouji_cha_enj = enj_kwa : gosub *r_cha_kwa_ep4_3        ;rg
	if %r_hyouji_cha_enj = enj_ber : gosub *r_cha_ber_ep4_3        ;rg

	if ?r_cha_text[4][%r_hyouji_cha_enj][2] > %cha_text_page	lsp cha_next_lsp,tips_next,200,407
	if %cha_text_page > 1	lsp cha_back_lsp,tips_back,250,407

