;********************************************************************************
; 画像初期化ルーチン
*r_gazou_shokika
	for %tmp = 100 to r_used_lsp : csp %tmp next
	csp r_bg_lsp
	csp r_black_lsp
return
;********************************************************************************


;********************************************************************************
; 右クリックシステムを抜ける処理
*r_exit
	btndef ""
	gosub *r_gazou_shokika
	csp r_bg_lsp
	csp r_black_lsp
	seplay 9,1100
	print 1
	texton
	if %monoflg = 1 mono 1
	if %monoflg = 2 mono 2

return ;右クリックシステムを抜ける

;-------------------------------------
; 右クリックシステムを抜ける処理割れるエフェクトなし
*r_exit2
	btndef ""
	gosub *r_gazou_shokika
	csp r_bg_lsp
	csp r_black_lsp
	print 1
	texton
	if %monoflg = 1 mono 1
	if %monoflg = 2 mono 2
return ;右クリックシステムを抜ける

