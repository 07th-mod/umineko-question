	if %tmp2 > 11 mov %tmp2,11
	; this add is for grim tip 0
	add %tmp2,1

	for %tmp = 1 to %tmp2 : mov ?grim[%tmp][grim_flg],1 : next
~

;コンディションチェック、コンディションが−１の場合は、%r_hyouji_cha_maを０に
if ?r[%r_hyouji_cha][condition]= -1 mov %r_hyouji_cha,0

;タイトルから入って来た時にはキャラを全員liveで背景はランダムで表示
