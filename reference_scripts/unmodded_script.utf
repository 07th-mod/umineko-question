		if %grim_page = 1 mov $r_grim_txt_path,":a;bmp\r_click\text\notes\ep1n1_1.png"


	*grim_2

	notif %r_hyouji_grim = 3 goto *grim_3
		cell grim3_lsp,1
		if %grim_page = 1 mov $r_grim_txt_path,":a;bmp\r_click\text\notes\ep1n2_1.png"
	*grim_3

