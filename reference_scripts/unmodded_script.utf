*rmenu_title_back_ep4_2

	;確認メッセージの表示
	mov $witchh4, title_back_bg
	setRLangString $witchh4, ""
lsp title_back_bg_lsp,$witchh4,193,171,230
	lsp title_back_yes_lsp,title_back_yes,216,216
	lsp title_back_no_lsp,title_back_no,216,254
	print 1

	btndef ""
	
	spbtn title_back_yes_lsp,title_back_yes_lsp
	spbtn title_back_no_lsp,title_back_no_lsp
	
	*rmenu_title_back_btn_lp_ep4_2

	btnwait2 %tmp
	
	notif %tmp = title_back_yes_lsp jumpf
		btndef ""
		csp -1
		E_A
		mov %title_skip,1
		seplay 9,18
		bg black,18,3000,"bmp\r_click\efe\kannon_r.bmp"
		delay 3000
		texton
		
		reset
	~

	if %tmp = title_back_no_lsp csp title_back_bg_lsp : csp title_back_yes_lsp :csp title_back_no_lsp : seplay 9,1000 : goto *rmenu_sai_hyouji_ep4_2
	if %tmp = 0 csp title_back_bg_lsp : csp title_back_yes_lsp :csp title_back_no_lsp goto *rmenu_sai_hyouji_ep4_2
	if %tmp = -1 csp title_back_bg_lsp : csp title_back_yes_lsp :csp title_back_no_lsp goto *rmenu_sai_hyouji_ep4_2
	
	
	goto *rmenu_title_back_btn_lp_ep4_2

