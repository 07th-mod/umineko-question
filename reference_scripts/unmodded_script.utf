langjp「…奥様、どうかお気を鎮めください……！」@
;＜源次
langen^"...Madam, please, calm yourself...!"^@
ld r,$JES_IkariA2,24

langjp「母さんは嘘なんかついてない！@　ならこんなの聞き捨てなきゃ！！」\
;＜朱志香
langen^"Mom, you aren't lying!^@^  So there's no reason for you to listen to this!!"^\

clr_oldnew_bg
