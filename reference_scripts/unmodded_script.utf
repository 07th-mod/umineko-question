		mov %r_hyouji_tips,0
		mov %tips_page,1
		mov %r_hyouji_grim,0
		mov %grim_page,1
			lsp 0,":b;bmp\efe\ware.png",0,0
			E_A
			seplay 9,1100
			print 1
			delay 10
			csp 0
			mov %r_side_change,1
		gosub *r_gazou_shokika
		goto *rmenu_main_ep2
	~

	;エピソード移動ボタン（押されたボタンによって、EP１のTips、EP２のTipsを移動する）
